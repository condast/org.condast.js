Manifest-Version: 1.0
Bundle-ManifestVersion: 2
Bundle-Name: YouTube Viewer Bundle
Bundle-SymbolicName: org.youtube.viewer;singleton:=true
Bundle-Version: 1.0.0.qualifier
Bundle-Activator: org.youtube.viewer.Activator
Bundle-Vendor: Condast
Bundle-RequiredExecutionEnvironment: JavaSE-1.8
Import-Package: jakarta.servlet;version="[6.1.0,7.0.0)",
 jakarta.servlet.http;version="[6.1.0,7.0.0)",
 org.condast.commons.strings,
 org.condast.js.commons.eval,
 org.eclipse.rap.rwt.service;version="3.1.0",
 org.eclipse.rap.rwt.widgets;version="3.0.2",
 org.eclipse.swt.browser,
 org.eclipse.swt.graphics,
 org.eclipse.swt.widgets,
 org.osgi.framework;version="1.3.0",
 org.osgi.service.http.whiteboard;version="[1.1.0,2.0.0)",
 org.osgi.service.http.whiteboard.propertytypes;version="[1.1.0,2.0.0)"
Bundle-ActivationPolicy: lazy
Export-Package: org.youtube.viewer.core,
 org.youtube.viewer.model,
 org.youtube.viewer.session,
 org.youtube.viewer.view
Automatic-Module-Name: org.youtube.viewer
